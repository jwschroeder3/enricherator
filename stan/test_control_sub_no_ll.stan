functions {
    // Taken straight from stan code generated by brms
    /* Efficient computation of the horseshoe prior
        * see Appendix C.1 in https://projecteuclid.org/euclid.ejs/1513306866
        * Args:
        *   z: standardized population-level coefficients
        *   lambda: local shrinkage parameters
        *   tau: global shrinkage parameter
        *   c2: slab regularization parameter
        * Returns:
        *   population-level coefficients following the horseshoe prior
    */
    vector horseshoe(vector z, vector lambda, real tau, real c2) {
        int K = rows(z);
        vector[K] lambda2 = square(lambda);
        vector[K] lambda_tilde = sqrt(c2 * lambda2 ./ (c2 + tau^2 * lambda2));
        return z .* lambda_tilde * tau;
    }

    // Same trend as used in DESeq2 and DEXSeq
    vector overdisp_f(vector y_hat, real a, real b) {
        int L = rows(y_hat);
        vector[L] overdisp = ( b / exp(y_hat) ) + a;
        return overdisp;
    }

    // Hill function
    vector hill_f(array[] int y, real libsize, real h, real k) {
        int L = num_elements(y);
        real y_hat;
        vector[L] signoise;
        for (l in 1:L) {
            y_hat = y[l] ./ libsize;
            //print("y_hat: ", y_hat);
            signoise[l] = y_hat^h / (k + y_hat^h);
        }
        return signoise;
    }
}

data {
    int<lower=1> L; // number of positions
    int<lower=1> S; // number of samples
    int<lower=1> B; // number of betas
    int<lower=1> A; // number of alphas
    int<lower=1> G; // number of gammas
    int<lower=1, upper=2> Q; // number of strands
    real alpha_prior;
    array[S,3] int param_idx_arr; // parameter index for each of alpha, beta, gamma
    array[G] int beta_sub_idx; // for each G, establishes which B to subtract
    array[S] int sample_x; // sample_id for each datum
    array[S,Q,L] int Y; // counts
    array[S] real<lower=0> libsize; // exposure term for each sample
    real<lower=0> hs_df_beta; // local df
    real<lower=0> hs_df_global_beta; // global df
    real<lower=0> hs_df_slab_beta; // slab df
    real<lower=0> hs_scale_global_beta; // global prior scale
    real<lower=0> hs_scale_slab_beta; // slab prior scale
    real<lower=0> hs_df_gamma; // local df
    real<lower=0> hs_df_global_gamma; // global df
    real<lower=0> hs_df_slab_gamma; // slab df
    real<lower=0> hs_scale_global_gamma; // global prior scale
    real<lower=0> hs_scale_slab_gamma; // slab prior scale
    int<lower=1> a_sub_L;
    int<lower=1> b_sub_L;
    int<lower=1> g_sub_L;
    int<lower=1> a_num_non_zero;
    int<lower=1> b_num_non_zero;
    int<lower=1> g_num_non_zero;
    vector<lower=0,upper=1>[a_num_non_zero] a_weights_vals;
    vector<lower=0,upper=1>[b_num_non_zero] b_weights_vals;
    vector<lower=0,upper=1>[g_num_non_zero] g_weights_vals;
    array[a_num_non_zero] int a_col_accessor;
    array[b_num_non_zero] int b_col_accessor;
    array[g_num_non_zero] int g_col_accessor;
    array[L+1] int a_row_non_zero_number;
    array[L+1] int b_row_non_zero_number;
    array[L+1] int g_row_non_zero_number;
    int<lower=0, upper=1> gather_log_lik;
}

transformed data {
    array[S] real log_libsize;
    array[S] real log_pseudocount;
    int N = L*Q*S;
    int b_num_hs = b_sub_L;
    int g_num_hs = g_sub_L;
    {
        real mean_loglib;
        real cent_libsize;
        for (s in 1:S) {
            if (libsize[s] == 0.0) {
                log_libsize[s] = log(0.1);
            } else {
                log_libsize[s] = log(libsize[s]);
            }
        }
        for (s in 1:S) {
            log_pseudocount[s] = log_libsize[s] - log(50.0);
        }
    }
}

parameters {
    vector[S] psi; // log_pseudocount parameter for each sample
    vector<lower=0>[3] prec; // stratify global precision inference by ChIP vs input vs ipod
    array[A,Q] vector[a_sub_L] sub_Alpha; // one intercept for each genotype/sub-position

    //vector<lower=0>[G] t_sd;
    //vector<lower=0>[G] t_nu;
    vector<lower=0>[G] a_cubic;
    vector[G] b_cubic;
    vector[G] c_cubic;

    // local parameters for horseshoe prior
    array[G,Q] vector[g_sub_L] zgamma;
    vector<lower=0>[G] caux_gamma;
    array[G,Q] vector<lower=0>[g_sub_L] lambda_gamma;
    vector<lower=0>[G] tau_gamma;

    array[B,Q] vector[b_sub_L] zbeta;
    vector<lower=0>[B] caux_beta;
    array[B,Q] vector<lower=0>[b_sub_L] lambda_beta;
    vector<lower=0>[B] tau_beta;
}

transformed parameters {
    array[B,Q] vector[L] Beta;
    array[A,Q] vector[L] Alpha; // one intercept for each genotype/position combination
    array[G,Q] vector[L] Gamma;
    array[G,Q] vector[L] control_ests;
    array[G,Q] vector[L] non_sub;

    //real lprior = 0.0;

    {
        vector[b_sub_L] sub_Beta; 
        vector[g_sub_L] sub_gamma;
        vector[L] tmp_Beta;
        vector[L] tmp_Gamma;
        vector[L] tmp_nonsub;
        vector[L] control_est;
        //vector[L] beta_gr_zero;
        //vector[L] gamma_gr_zero;
        //vector[L] gr_zero;
        int b_sub_idx;
        vector[g_sub_L] lambda_tilde_gamma;
        vector[b_sub_L] lambda_tilde_beta;
        real c2;
        for (b in 1:B) {
            c2 = square(hs_scale_slab_beta * sqrt(caux_beta[b]));
            for (q in 1:Q) {
                lambda_tilde_beta = sqrt( c2 * square(lambda_beta[b,q]) ./ (c2 + tau_beta[b]^2 * square(lambda_beta[b,q])));
                sub_Beta = zbeta[b,q] .* lambda_tilde_beta*tau_beta[b];
                Beta[b,q] = csr_matrix_times_vector(
                    L,
                    b_sub_L,
                    b_weights_vals,
                    b_col_accessor,
                    b_row_non_zero_number,
                    sub_Beta
                );
            }
        }
        for (g in 1:G) {
            c2 = square(hs_scale_slab_gamma * sqrt(caux_gamma[g]));
            for (q in 1:Q) {

                lambda_tilde_gamma = sqrt(
                    c2 * square(lambda_gamma[g,q])
                    ./ (c2 + tau_gamma[g]^2 * square(lambda_gamma[g,q]))
                );
                sub_gamma = zgamma[g,q] .* lambda_tilde_gamma*tau_gamma[g];
                tmp_nonsub = csr_matrix_times_vector(
                    L,
                    g_sub_L,
                    g_weights_vals,
                    g_col_accessor,
                    g_row_non_zero_number,
                    sub_gamma
                );
                
                // fetch correct Betas to fit cubic relationship
                b_sub_idx = beta_sub_idx[g];
                tmp_Beta = Beta[b_sub_idx,q];
                for (l in 1:L) {
                    if (tmp_Beta[l] > 0 && tmp_nonsub[l] > 0) {
                        // if both control and chip are positive, estimate chip based on control
                        // using cubic relationship.
                        control_est[l] = (
                            a_cubic[g] * tmp_Beta[l]
                            + b_cubic[g] * tmp_Beta[l]^2
                            + c_cubic[g] * tmp_Beta[l]^3
                        );
                    } else {
                        control_est[l] = 0.0;
                    }
                    //gr_zero[l] = tmp_Beta[l] > 0 && tmp_Gamma[l] > 0;
                }
                non_sub[g,q] = tmp_nonsub;
                Gamma[g,q] = tmp_nonsub - control_est;
                control_ests[g,q] = control_est;
            }
        }
    }

    for (a in 1:A) {
        for (q in 1:Q) {
            Alpha[a,q] = csr_matrix_times_vector(
                L,
                a_sub_L,
                a_weights_vals,
                a_col_accessor,
                a_row_non_zero_number,
                sub_Alpha[a,q]
            );
        }
    }

    //lprior += student_t_lupdf(a_cubic | 3, 1.0, 0.5);
    //lprior += student_t_lupdf(b_cubic | 3, 0.0, 0.5);
    //lprior += student_t_lupdf(c_cubic | 3, 0.0, 0.5);

    //for (b in 1:B) {
    //    lprior += inv_gamma_lupdf(caux_beta[b] | 0.5*hs_df_slab_beta, 0.5*hs_df_slab_beta);
    //    lprior += cauchy_lupdf(tau_beta[b] | 0, hs_scale_global_beta^2);
    //    for (q in 1:Q) {
    //        lprior += std_normal_lupdf(zbeta[b,q]);
    //        lprior += student_t_lupdf(lambda_beta[b,q] | hs_df_beta, 0, 1);
    //    }
    //}

    //for (g in 1:G) {
    //    lprior += inv_gamma_lupdf(caux_gamma[g] | 0.5*hs_df_slab_gamma, 0.5*hs_df_slab_gamma);
    //    lprior += cauchy_lupdf(tau_gamma[g] | 0, hs_scale_global_gamma^2);
    //    for (q in 1:Q) {
    //        lprior += std_normal_lupdf(zgamma[g,q]);
    //        lprior += student_t_lupdf(lambda_gamma[g,q] | hs_df_gamma, 0, 1);
    //    }
    //}

    //for (a in 1:A) {
    //    for (q in 1:Q) {
    //        lprior += normal_lupdf(sub_Alpha[a,q] | alpha_prior, 4);
    //    }
    //}

    //lprior += lognormal_lupdf(prec | 0, 1);
    //for (s in 1:S) {
    //    lprior += normal_lupdf(log_pseudocount[s] | psi[s], 1.0);
    //}

}

model {
    int sample_type;
    array[3] int param_idxs;
    vector[L] Y_hat;
    real libsize_s;
    real psi_s;

    //target += lprior;

    //t_sd ~ std_normal();
    //t_nu ~ std_normal();
    a_cubic ~ student_t(3, 1.0, 0.5);
    b_cubic ~ student_t(3, 0.0, 0.5);
    c_cubic ~ student_t(3, 0.0, 0.5);

    for (b in 1:B) {
        caux_beta[b] ~ inv_gamma(0.5*hs_df_slab_beta, 0.5*hs_df_slab_beta);
        tau_beta[b] ~ cauchy(0, hs_scale_global_beta^2);
        for (q in 1:Q) {
            zbeta[b,q] ~ std_normal();
            lambda_beta[b,q] ~ student_t(hs_df_beta, 0, 1);
            //sub_Beta[b,q] ~ student_t(3, 0, 1);
        }
    }

    for (g in 1:G) {
        caux_gamma[g] ~ inv_gamma(0.5*hs_df_slab_gamma, 0.5*hs_df_slab_gamma);
        tau_gamma[g] ~ cauchy(0, hs_scale_global_gamma^2);
        for (q in 1:Q) {
            zgamma[g,q] ~ std_normal();
            lambda_gamma[g,q] ~ student_t(hs_df_gamma, 0, 1);
            //non_sub[g,q] ~ student_t(t_nu[g], control_ests[g,q], t_sd[g]);
        }
    }

    for (a in 1:A) {
        for (q in 1:Q) {
            sub_Alpha[a,q] ~ normal(alpha_prior, 4);
        }
    }

    prec ~ lognormal(0, 1);
    log_pseudocount ~ normal(psi, 1.0);

    for (s in 1:S) {

        sample_type = sample_x[s];
        param_idxs = param_idx_arr[s];
        libsize_s = log_libsize[s];
        psi_s = psi[s];

        for (q in 1:Q) {

            if (sample_type == 0) {
                Y_hat = Alpha[param_idxs[1],q] 
                    + libsize_s;
            } else if (sample_type == 1) {
                Y_hat = Alpha[param_idxs[1],q] 
                    + Beta[param_idxs[2],q] 
                    + libsize_s;
            } else {
                Y_hat = Alpha[param_idxs[1],q] 
                    + non_sub[param_idxs[3],q] 
                    + libsize_s;
            }
            Y[s,q] ~ neg_binomial_2_log(log_sum_exp(Y_hat, psi_s), prec[sample_type+1]);
            //target += neg_binomial_2_lpmf(Y[s,q] | exp(Y_hat_signal) + exp(psi[s]), prec[sample_type+1]);
        }
    }
}

